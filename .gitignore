.venv/
__pycache__/
*.pyc
backend/data/projects/*
!backend/data/projects/.gitkeep
backend/data/temp/*
!backend/data/temp/.gitkeep
backend/data/test_projects/
backend/data/jobs/
backend/data/settings.json
backend/static_placeholder/
frontend/node_modules/
frontend/dist/
.DS_Store
*.log

# Real capture footage: large, personal, and not ours to redistribute.
captures/
benchmarks/runs/

# Self-signed development certificates for LAN HTTPS.
.certs/

# Android build artefacts
android/build/
android/*.apk

android/debug.keystore

# Flutter build output
app/build/
app/.dart_tool/
app/android/.gradle/
app/android/local.properties
app/.flutter-plugins-dependencies

# Release signing material. The keystore and its passwords must never be
# committed: with them, anyone can sign an update Android accepts as ours.
# Keep a backup somewhere safe -- losing the keystore means never being able
# to update an installed copy of the app again.
app/android/key.properties
app/android/*.jks
*.keystore

# pytest --cov leaves this behind on every run.
.coverage
