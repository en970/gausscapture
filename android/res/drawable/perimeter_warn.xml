<?xml version="1.0" encoding="utf-8"?>
<!--
  An 8 dp border around the whole preview, the one signal readable without looking at the screen.
  At arm's length with the operator's gaze on the subject, the display sits in peripheral vision,
  which is sensitive to motion and luminance and poor at detail and colour. A bright pulsing
  perimeter is detectable there; a word in the middle of the screen is not.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <stroke android:width="8dp" android:color="#FFB020" />
    <solid android:color="#00000000" />
</shape>
