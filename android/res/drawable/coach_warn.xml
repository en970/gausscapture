<?xml version="1.0" encoding="utf-8"?>
<!--
  Opaque, not translucent. Contrast against a live camera image cannot be guaranteed by any
  amount of blur or scrim, because the background is whatever the operator happens to be
  pointing at. The amber is 10.5:1 against the ink colour drawn on it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFB020" />
    <corners android:radius="20dp" />
</shape>
